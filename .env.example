# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:AA...

# Postgres connection string — use the POOLED (host contains "-pooler") URL from Vercel Postgres
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require

# Random string (32+ chars) for webhook verification, e.g.: openssl rand -hex 16
WEBHOOK_SECRET=

# Random string (16+ chars) for the cron endpoint, e.g.: openssl rand -hex 16
CRON_SECRET=

# ---- Live trading on KuCoin SPOT (optional; default = pure simulation) ----
# Only this Telegram user id may trade for real (send /start to @userinfobot to find yours)
OWNER_TG_ID=
# Set to 1 to allow real orders (the owner still has to switch it on with /live)
LIVE_TRADING=0
# Create the key on KuCoin with permissions: General + Spot Trading ONLY (never Withdrawal / Transfer)
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
# Optional: KuCoin sandbox for testing (needs separate sandbox keys)
# KUCOIN_BASE_URL=https://openapi-sandbox.kucoin.com
