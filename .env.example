# BotFather token — never commit the real value
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Numeric Telegram user ID of the single administrator (not @username)
ADMIN_TELEGRAM_ID=123456789

# A random 32+ character value. Used to verify Telegram webhooks.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Upstash Redis REST credentials
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me

# A separate random secret; Vercel sends it to the cron endpoint as Bearer auth.
CRON_SECRET=replace_with_another_long_random_secret

# Optional settings
# DEFAULT_FEE_RATE_PCT=0.1
# SEND_TRADE_NOTIFICATIONS=false
