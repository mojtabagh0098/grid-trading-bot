# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:AA...

# Postgres connection string — use the POOLED (host contains "-pooler") URL from Vercel Postgres
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require

# Random string (32+ chars) for webhook verification, e.g.: openssl rand -hex 16
WEBHOOK_SECRET=

# Random string (16+ chars) for the cron endpoint, e.g.: openssl rand -hex 16
CRON_SECRET=
